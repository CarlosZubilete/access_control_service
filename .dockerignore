# ============================================================================
# DOCKER BUILD CONTEXT EXCLUSIONS
# ============================================================================

# Dependencies & Build Outputs
node_modules/
dist/
.pnpm-debug.log*

# Documentation, Diagrams, and Local Notes (Not needed in production container)
documents/
assets/
plantuml/
README.md
todo.md
*.md

# Utilities, Postman collections, and development scripts
utils/

# Environment configurations (Secrets must be injected at runtime)
.env
.env.local
.env.*

# Version control and metadata
.git/
.gitignore
.gitattributes

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing and Quality Tools
coverage/
*.log
jest.config.js
.eslintrc*
.prettierrc*
.mocharc.json

# CI/CD pipelines
.github/
.gitlab-ci.yml
.circleci/

# HTTP client files (REST client / Bruno / Postman test files)
*.http
*.rest

# Docker and Compose configuration files (not needed inside the image)
Dockerfile
docker-compose.yml


# Alternative package manager lock files (since you use pnpm)
package-lock.json
yarn.lock